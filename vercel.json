{
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/api/s?slug=:slug"
    },
    {
      "source": "/shop",
      "destination": "/api/s?slug=shop"
    },
    {
      "source": "/.well-known/omenz-flyer.json",
      "destination": "/api/hit?f=index"
    },
    {
      "source": "/.well-known/omenz-keys.json",
      "destination": "/api/hit?f=keys"
    },
    {
      "source": "/feed.json",
      "destination": "/api/hit?f=feed"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/hit?f=llms"
    },
    {
      "source": "/flyers/:id.json",
      "destination": "/api/hit?f=flyer-:id"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/hit?f=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/hit?f=sitemap"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/x402",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/agent.json",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/x402list.txt",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/402index-verify.txt",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/mcp.json",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/mcp-registry-auth",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/mcp",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/api/tollbooth/:path*",
      "destination": "/api/tollbooth"
    }
  ],
  "functions": {
    "api/tollbooth.py": {
      "includeFiles": "api/_tollbooth/**",
      "maxDuration": 30
    }
  },
  "redirects": [],
  "crons": [
    {
      "path": "/api/tollbooth/v1/track-record/rollup",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/tollbooth/v1/uptime/run",
      "schedule": "45 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}