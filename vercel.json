{
  "rewrites": [
    {
      "source": "/.well-known/omenz-flyer.json",
      "destination": "/api/hit?f=index"
    },
    {
      "source": "/.well-known/omenz-keys.json",
      "destination": "/api/hit?f=keys"
    },
    {
      "source": "/feed.json",
      "destination": "/api/hit?f=feed"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/hit?f=llms"
    },
    {
      "source": "/flyers/:id.json",
      "destination": "/api/hit?f=flyer-:id"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/hit?f=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/hit?f=sitemap"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/x402",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/agent.json",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/.well-known/mcp-registry-auth",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/mcp",
      "destination": "/api/tollbooth"
    },
    {
      "source": "/api/tollbooth/:path*",
      "destination": "/api/tollbooth"
    }
  ],
  "functions": {
    "api/tollbooth.py": {
      "includeFiles": "api/_tollbooth/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/s/run-it",
      "destination": "https://omenz-shop.fourthwall.com/products/run-it-premium-tee",
      "permanent": false
    },
    {
      "source": "/s/evolve-or-dissolve",
      "destination": "https://omenz-shop.fourthwall.com/products/evolve-or-dissolve-premium-tee",
      "permanent": false
    },
    {
      "source": "/s/caught-in-code",
      "destination": "https://omenz-shop.fourthwall.com/products/caught-in-code-the-divine-download-tee",
      "permanent": false
    },
    {
      "source": "/s/dont-chip-flash-me-bro",
      "destination": "https://omenz-shop.fourthwall.com/products/dont-chip-flash-me-bro",
      "permanent": false
    },
    {
      "source": "/s/human-difficulties-detected",
      "destination": "https://omenz-shop.fourthwall.com/products/human-difficulties-detected",
      "permanent": false
    },
    {
      "source": "/s/ai-shole",
      "destination": "https://omenz-shop.fourthwall.com/products/ai-shole",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/tollbooth/v1/track-record/rollup",
      "schedule": "15 7 * * *"
    }
  ]
}