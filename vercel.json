{
  "rewrites": [
    {
      "source": "/.well-known/omenz-flyer.json",
      "destination": "/api/hit?f=index"
    },
    {
      "source": "/.well-known/omenz-keys.json",
      "destination": "/api/hit?f=keys"
    },
    {
      "source": "/feed.json",
      "destination": "/api/hit?f=feed"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/hit?f=llms"
    },
    {
      "source": "/flyers/:id.json",
      "destination": "/api/hit?f=flyer-:id"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/hit?f=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/hit?f=sitemap"
    },
    {
      "source": "/api/tollbooth/:path*",
      "destination": "/api/tollbooth"
    }
  ],
  "functions": {
    "api/tollbooth.py": {
      "includeFiles": "api/_tollbooth/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/s/run-it",
      "destination": "https://omenz-shop.fourthwall.com/products/run-it",
      "permanent": false
    },
    {
      "source": "/s/evolve-or-dissolve",
      "destination": "https://omenz-shop.fourthwall.com/products/evolve-or-dissolve",
      "permanent": false
    },
    {
      "source": "/s/caught-in-code",
      "destination": "https://omenz-shop.fourthwall.com/products/caught-in-code-the-divine-download-tee",
      "permanent": false
    }
  ]
}